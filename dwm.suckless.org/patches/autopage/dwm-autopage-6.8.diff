-void
-manage(Window w, XWindowAttributes *wa)
+static unsigned int
+nexttag(unsigned int tag)
+{
+	if (tag >= (1U << (LENGTH(tags) - 1)))
+		return 0;
+	return tag << 1;
+}
+
+static int
+nclientstag(Monitor *m, unsigned int tag)
+{
+	int n = 0;
+	Client *c;
+	if (!tag)
+		return 0;
+	for (c = m->clients; c; c = c->next)
+		if (!c->isfloating && (c->tags & tag))
+			n++;
+	return n;
+}
+
+static void
+autopagemove(Client *c, unsigned int tag)
 {
+	c->tags = tag;
+	c->isautopaged = 1;
+}
+
